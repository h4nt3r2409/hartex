# Docker deployment settings (copy this file to .env)
# ARTEX_TAG is the tag of the image ghcr.io/h4nt3r2409/hartex consumed by docker compose.
# latest points to the most recent release; to pin to a specific release, specify a v* tag.
ARTEX_TAG=latest
POSTGRES_USER=artex
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=artex

# LLM (set one or both. You can also leave these blank and configure them later in the UI)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ARTEX_LLM_PROVIDER=
ARTEX_LLM_MODEL=
ARTEX_LLM_BASE_URL=
ARTEX_LLM_PROXY=

# First-run protection (prevents remote takeover of the admin account)
# - Web/API ports are published only on the host's 127.0.0.1 by default. If you need to
#   connect from another device, change ARTEX_BIND to 0.0.0.0, but complete the initial setup first.
# - On first startup, a random setup token is printed in the logs (docker compose logs artex),
#   and you must enter it on the /setup screen to create the admin password.
#   If ARTEX_SETUP_TOKEN is set, that value becomes the token and is not printed in the logs.
# - If ARTEX_ADMIN_PASSWORD is set, initialization uses that value directly without /setup (at least 8 characters).
ARTEX_BIND=127.0.0.1
ARTEX_SETUP_TOKEN=
ARTEX_ADMIN_PASSWORD=
# Browser cross-origin (CORS) allowlist (comma-separated). The built-in UI is same-origin, so leave this blank.
ARTEX_CORS_ORIGINS=
