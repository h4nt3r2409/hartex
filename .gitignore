# backend
/data/
*.db
*.db-wal
*.db-shm
config.json
scheduler_state.json
__pycache__/
*.pyc
*.pyo

# frontend
web/node_modules/
web/.next/
web/tsconfig.tsbuildinfo
web/next-env.d.ts
*.local

# development tools
.playwright-mcp/
.playwright-cli/
.idea/
.vscode/
*.swp
*.swo

# os
.DS_Store
Thumbs.db

# claude code local state
.claude/

# Single-binary output with the embedded frontend
/artex
# Intermediate files left next to the executable by one-click updates (staging / backup / failed / upgrade marker)
/artex.new
/artex.new.sha256
/artex.old
/artex.failed
/artex.upgrade.json
/server/webui/dist/
/dist/

# JWT signing key (generated at runtime in the project root; never commit)
/jwt.key

# Local environment generated by Docker deployment (contains passwords/keys; do not commit)
.env

# Event logs produced by scheduler runs/simulation (test artifacts; do not commit)
*-events.csv

# Benchmark-related files (local artifacts; do not commit)
/bench/
/Dockerfile.bench
/Dockerfile.bench.v2
# --- hartex local operations: do not commit (owner instruction: test/scan results stay private) ---
work/
test-results/
scan-output/
evidence-local/
# Runtime data created by starting the demo app locally (recording-proxy traffic index DB,
# mitmproxy CA private key, etc.); do not commit it to the public repository.
/demo-data/
*.local.env
# D2 model-comparison live test: it lives inside package agent, so it cannot go under work/,
# and it consumes OPENROUTER_API_KEY and the network. It is a local-only artifact and must
# not be committed. Only this exact path is ignored so upstream-tracking tests are unaffected.
agent/d2_models_live_test.go

# API keys and secrets: never commit, wherever they live
*.env
secrets.env

# --- Windows source-build local artifacts: do not commit ---
# Windows single binary produced by `go build -o artex.exe` (counterpart of /artex on Unix)
/artex.exe
# Secrets used in local configuration (for example a PostgreSQL password). Never commit.
/.secrets/
# Native-binding cache created when SWC_NATIVE_BINDING_CACHE is pointed inside the project
/.swc-cache/
# Runtime logs redirected while running artex.exe in the foreground
/artex.out.log
/artex.err.log
