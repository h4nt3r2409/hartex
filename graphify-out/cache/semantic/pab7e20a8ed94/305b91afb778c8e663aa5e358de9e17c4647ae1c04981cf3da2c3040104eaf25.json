{"nodes": [{"id": "scripts_external_links_allowlist", "label": "External Links Allowlist (Known DOWN)", "file_type": "document", "source_file": "scripts/external-links-allowlist.txt", "source_location": "lines 1-11", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A URL listed here that comes back DOWN during the liveness check is classified as ALLOWED and excluded from the --strict exit code. Only dead links the project does not own and cannot fix (inherited from preserved upstream text) belong here; project-curated broken links must be fixed instead of allowlisted."}, {"id": "scripts_check_external_links", "label": "check-external-links.py", "file_type": "code", "source_file": "scripts/external-links-allowlist.txt", "source_location": "line 1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "scripts_external_links_allowlist_strict_mode", "label": "Strict Mode Exit Code", "file_type": "concept", "source_file": "scripts/external-links-allowlist.txt", "source_location": "lines 4-5", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Allowlisted dead links are excluded from the --strict exit code so upstream-owned, unfixable 404s do not fail the link check."}, {"id": "scripts_external_links_allowlist_preserve_upstream_text_policy", "label": "Preserve Upstream Text Policy", "file_type": "rationale", "source_file": "scripts/external-links-allowlist.txt", "source_location": "lines 13-25", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Preserved upstream text (CHANGELOG.zh.md, README.zh.md) is left exactly as upstream wrote it, so upstream links inside it are not edited even when they are dead; this fork references upstream assets for provenance and credit."}, {"id": "scripts_external_links_allowlist_agpl_attribution", "label": "AGPL-3.0 Attribution Requirement", "file_type": "concept", "source_file": "scripts/external-links-allowlist.txt", "source_location": "lines 20-22", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The AGPL-3.0 attribution must be kept, so the upstream links themselves are not removed from the documents even though they currently 404."}, {"id": "scripts_external_links_allowlist_begininvoke_profile", "label": "begininvoke GitHub Profile", "file_type": "concept", "source_file": "scripts/external-links-allowlist.txt", "source_location": "lines 12-16", "source_url": "https://github.com/begininvoke", "captured_at": null, "author": null, "contributor": null, "rationale": "Contributor profile credited by upstream CHANGELOG.zh.md:539; the account was renamed or deleted so the profile returns 404, and the preserved upstream text is not changed. Checked 2026-10-07."}, {"id": "scripts_external_links_allowlist_upstream_repository", "label": "Autumn-27/ARTEX Upstream Repository", "file_type": "concept", "source_file": "scripts/external-links-allowlist.txt", "source_location": "lines 18-27", "source_url": "https://github.com/Autumn-27/ARTEX", "captured_at": null, "author": null, "contributor": null, "rationale": "Upstream repository that this fork derives from; its repository, demo, release and compare assets are publicly unreachable (404) as of 2026-10, but are retained for provenance and AGPL attribution."}, {"id": "scripts_external_links_allowlist_norma_repository", "label": "Autumn-27/norma Repository", "file_type": "concept", "source_file": "scripts/external-links-allowlist.txt", "source_location": "line 28", "source_url": "https://github.com/Autumn-27/norma", "captured_at": null, "author": null, "contributor": null}, {"id": "scripts_external_links_allowlist_online_demo", "label": "ARTEX Online Demo (Vercel)", "file_type": "concept", "source_file": "scripts/external-links-allowlist.txt", "source_location": "line 26", "source_url": "https://artex-demo.vercel.app/", "captured_at": null, "author": null, "contribu