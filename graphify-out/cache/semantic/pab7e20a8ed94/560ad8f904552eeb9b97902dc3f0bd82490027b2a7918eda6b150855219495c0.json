{"nodes": [{"id": "sidequestion_readme_document", "label": "ARTEX /btw Side Questions (English README)", "file_type": "document", "source_file": "sidequestion/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "sidequestion_readme_btw_side_question", "label": "/btw Side Question", "file_type": "concept", "source_file": "sidequestion/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A side question is answered separately from the main conversation so a user can ask without disturbing a running agent; closing the panel, refreshing, or losing SSE must not cancel the model request, and Stop affects only the current side question while Clear removes side-question history but leaves the main snapshot intact."}, {"id": "sidequestion_readme_context_snapshot", "label": "Immutable Structured Agent Context Snapshot", "file_type": "rationale", "source_file": "sidequestion/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Responses must reflect the agent context at submission time, so a JSON deep copy of structured messages, system prompt, tool definitions, and generation parameters is published at request start, on completed model responses, and at terminal states; half-finished streamed responses are excluded and the last valid boundary is kept if streaming is interrupted."}, {"id": "sidequestion_readme_capture_go", "label": "capture.go Snapshot Capture Layer", "file_type": "code", "source_file": "sidequestion/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "sidequestion_readme_side_question_service", "label": "SideQuestionService", "file_type": "code", "source_file": "sidequestion/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "sidequestion_readme_side_question_panel", "label": "Side-question Panel (Sidebar / Drawer)", "file_type": "code", "source_file": "sidequestion/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "sidequestion_readme_persistence", "label": "side_question_sessions and side_question_requests Persistence", "file_type": "concept", "source_file": "sidequestion/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "sidequestion_readme_http_contract", "label": "Side-question HTTP Contract", "file_type": "concept", "source_file": "sidequestion/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "sidequestion_readme_sse", "label": "Cumulative Side-question SSE Stream", "file_type": "concept", "source_file": "sidequestion/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "sidequestion_readme_idempotency", "label": "Client Request Idempotency and Concurrency Limits", "file_type": "rationale", "source_file": "sidequestion/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "POST is idempotent through client_request_id: a matching ID and question returns the existing object with 200, conflicts return 409, and there is one in-flight request per parent session and four per service process, with 429 on the global limit. The client merges by request ID and ordinal and discards old callbacks when switching parent or clearing."}, {"id": "sidequestion_readme_independent_request", "label": "Independent Provider Request Isolation", "file_type": "rationale", "source_file": "sidequestion/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A side question is one standalone Provider call under an independent cancellation context within the service lifecycle. It creates no agent session and does not connect to the tool executor, main transcript, activity stream, or task graph, nor pass through the task model-switching chain, so it cannot mutate the main task; newly returned tool calls have no execution path."}, {"id": "sidequestion_readme_clear_operation", "label": "Clear and Cleanup-version Guard", "file_type": "rationale", "source_file": "sidequestion/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Clear increments the cleanup version and deletes requests; conditional updates prevent late-arriving callbacks from writing again, so a late write cannot revive already-cleared data. Physical parent deletion relies on the foreign-key cascade, and Worker logical deletion removes side-question data in the same transaction then rejects later snapshots."}, {"id": "sidequestion_readme_task_archive", "label": "v3 Task Archive Compatibility", "file_type": "concept", "source_file": "sidequestion/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "sidequestion_readme_worker", "label": "MainAgent and Worker Side-question Scope", "file_type": "concept", "source_file": "sidequestion/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "sidequestion_readme_tool_pairing", "label": "Tool Call / Result Pairing", "file_type": "rationale", "source_file": "sidequestion/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Tool calls are kept paired with their results through norma's MessagesForAPI, and compaction cut points never split a call from its result; if a single exchange is too large the whole exchange goes into the summary so structured tool context stays valid."}, {"id": "sidequestion_readme_norma_structured_messages", "label": "norma Structured Messages", "file_type": "concept", "source_file": "sidequestion/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "sidequestion_readme_btw_side_question", "target": "sidequestion_readme_context_snapshot", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "sidequestion/README.md", "source_location": null, "weight": 1.0}, {"source": "sidequestion_readme_btw_side_question", "target": "sidequestion_readme_side_question_panel", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "sidequestion/README.md", "source_location": null, "weight": 1.0}, {"source": "sidequestion_readme_context_snapshot", "target": "sidequestion_readme_capture_go", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "sidequestion/README.md", "source_location": null, "weight": 1.0}, {"source": "sidequestion_readme_context_snapshot", "target": "sidequestion_readme_tool_pairing", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "sidequestion/README.md", "source_location": null, "weight": 1.0}, {"source": "sidequestion_readme_tool_pairing", "target": "sidequestion_readme_norma_structured_messages", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "sidequestion/README.md", "source_location": null, "weight": 1.0}, {"source": "sidequestion_readme_capture_go", "target": "sidequestion_readme_norma_structured_messages", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "sidequestion/README.md", "source_location": null, "weight": 1.0}, {"source": "sidequestion_readme_side_question_service", "target": "sidequestion_readme_context_snapshot", "rel