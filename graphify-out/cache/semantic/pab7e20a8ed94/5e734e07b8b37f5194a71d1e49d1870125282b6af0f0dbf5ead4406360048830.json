{"nodes": [{"id": "screenshots_sessions_artex_console", "label": "ARTEX Agent Console", "file_type": "image", "source_file": "screenshots/sessions.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ARTEX is an agent-driven security testing console: a left module rail surrounds a session workspace where a main orchestrator, a planner, and specialized workers run an authorized penetration test while the operator watches and intervenes."}, {"id": "screenshots_sessions_navigation_sidebar", "label": "ARTEX Left Navigation Sidebar", "file_type": "image", "source_file": "screenshots/sessions.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "screenshots_sessions_session_detail_screen", "label": "Agent Session Detail Screen", "file_type": "image", "source_file": "screenshots/sessions.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The session detail screen splits into a left agent/task tree and a right conversation pane, so an operator can inspect the agent hierarchy and simultaneously steer the main agent."}, {"id": "screenshots_sessions_acme_penetration_campaign", "label": "Acme External Penetration Campaign (acme.com)", "file_type": "concept", "source_file": "screenshots/sessions.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Campaign header shows the target scope, tag t-acme-web, LLM configuration status, run state, and elapsed time, framing the whole session as one scoped engagement."}, {"id": "screenshots_sessions_campaign_objective", "label": "Campaign Objective: Backend Admin Access and Sensitive Data Confirmation", "file_type": "concept", "source_file": "screenshots/sessions.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Stated as '\u62ff\u5230 acme.com \u540e\u53f0\u7ba1\u7406\u6743\u9650\uff0c\u786e\u8ba4\u53ef\u8bfb\u53d6\u7528\u6237\u654f\u611f\u6570\u636e' - obtain admin access to the acme.com backend and confirm sensitive user data is readable, which explains why workers target the admin panel, backend functions, and order API."}, {"id": "screenshots_sessions_session_tab_bar", "label": "Session Detail Tab Bar", "file_type": "concept", "source_file": "screenshots/sessions.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Tabs (\u4f1a\u8bdd, \u603b\u89c8, \u63a2\u7d22\u94fe\u8def, \u53d1\u73b0, \u6d4b\u8bd5\u8d44\u4ea7, \u62e6\u622a\u5ba1\u6279, \u62a5\u544a) structure the campaign around conversation, exploration chain, findings, targets, approvals, and reporting rather than a single log stream."}, {"id": "screenshots_sessions_agent_hierarchy_tree", "label": "Hierarchical Agent Orchestration Tree", "file_type": "concept", "source_file": "screenshots/sessions.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Separating an orchestrator, a planner for situation assessment, and narrow workers lets the system dispatch and parallelize probes while keeping one human-interactive channel; each row carries independent status so progress is legible per task."}, {"id": "screenshots_sessions_main_agent_orchestration", "label": "Main Agent - Orchestration Session", "file_type": "concept", "source_file": "screenshots/sessions.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The main agent is the operator-facing orchestrator: it owns the interactive conversation, runs for 34m08s in this session, and is described as interactive (\u53ef\u4ea4\u4e92)."}, {"id": "screenshots_sessions_planner_situation_assessment", "label": "Planner - Situation Assessment", "file_type": "concept", "source_file": "screenshots/sessions.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A dedicated planner node (\u89c4\u5212 Planner \u00b7 \u6001\u52bf\u7814\u5224) evaluates the evolving situation and decides which probes to launch next, keeping strategy separate from execution."}, {"id": "screenshots_sessions_worker_subdomain_portscan", "label": "Worker #1: Subdomain Enumeration and Port Scan", "file_type": "concept", "source_file": "screenshots/sessions.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "screenshots_sessions_worker_weak_credentials", "label": "Worker #2: Admin Default and Weak Credential Test", "file_type": "concept", "source_file": "screenshots/sessions.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "screenshots_sessions_worker_backend_userdata_enum", "label": "Worker #3: Backend Function and User Data Enumeration", "file_type": "concept", "source_file": "screenshots/sessions.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "screenshots_sessions_worker_search_sqli", "label": "Worker #4: SQL Injection Test on www.acme.com/search", "file_type": "concept", "source_file": "screenshots/sessions.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "screenshots_sessions_worker_order_api", "label": "Worker #5: api.acme.com Order API Test", "file_type": "concept", "source_file": "screenshots/sessions.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "screenshots_sessions_realtime_status_badge", "label": "Realtime Worker Status Badge (\u5b9e\u65f6)", "file_type": "concept", "source_file": "screenshots/sessions.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Realtime badges mark workers still producing output, distinguishing active probes from completed ones (green check), so operators can read progress without opening every task."}, {"id": "screenshots_sessions_token_accounting", "label": "Session Token Accounting (input 2.7M, cache 1.7M, output 206k)", "file_type": "concept", "source_file": "screenshots/sessions.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Per-session token totals expose LLM cost and context pressure for long-running campaigns; the high cached-input share indicates prompt caching is being used to keep the multi-agent session affordable."}, {"id": "screenshots_sessions_interactive_agent_chat", "label": "Interactive Chat with Main Agent", "file_type": "concept", "source_file": "screenshots/sessions.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The conversation pane pairs user turns (dark, right-aligned) with agent turns (light, left-aligned) and an input box phrased as guidance to the main agent, making natural-language steering the primary human control surface."}, {"id": "screenshots_sessions_demo_placeholder_messages", "label": "Demo Placeholder Chat Content", "file_type": "concept", "source_file": "screenshots/sessions.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every bubble reads '(demo) \u6b64\u6d3b\u52a8\u7684\u5b8c\u6574\u5de5\u5177\u8f93\u5165/\u8f93\u51fa\u660e\u7ec6\u3002', showing the screenshot was captured in demo mode with tool input/output payloads redacted rather than real engagement data."}, {"id": "screenshots_sessions_llm_configured_badge", "label": "LLM Configured Status Badge", "file_type": "concept", "source_file": "screenshots/sessions.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "screenshots_sessions_exploring_run_state", "label": "Exploring Run State and Pause Control (\u63a2\u7d22\u4e2d / \u6682\u505c)", "file_type": "concept", "source_file": "screenshots/sessions.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A live run-state badge plus a pause button give the operator an immediate kill switch for an autonomous offensive-security session."}, {"id": "screenshots_sessions_intercept_approval", "label": "Intercept Rules and Approval Records", "file_type": "concept", "source_file": "screenshots/sessions.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Intercept rules and an approval log gate risky agent actions, providing an audit trail and a policy checkpoint before high-impact pentest steps execute."}, {"id": "screenshots_sessions_tooling_stack", "label": "Agent Tooling Stack (LLM, Agent, MCP, Skill, Tools)", "file_type": "concept", "source_file": "screenshots/sessions.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The sidebar groups model configuration, agent definitions, MCP connections, skills, and concrete tools as first-class, separately managed resources."}, {"id": "screenshots_sessions_security_assets_module", "label": "Discovery, Traffic, Asset, and Asset Sync Modules", "file_type": "concept", "source_file": "screenshots/sessions.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Findings and traffic captured during exploration are promoted into a managed asset inventory, closing the loop between ad-hoc probes and durable attack-surface records."}], "edges": [{"source": "screenshots_sessions_artex_console", "target": "screenshots_sessions_navigat